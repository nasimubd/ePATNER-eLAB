{
    "$schema": "https://json.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "vite build",
        "dev": "vite",
        "release": "bash scripts/release/run-semantic-release.sh",
        "release:dry": "bash scripts/release/run-semantic-release.sh --dry-run",
        "release:doctor": "git diff --check && git diff --cached --check && test -z \"$(git status --porcelain)\" && gh auth status"
    },
    "devDependencies": {
        "@tailwindcss/forms": "^0.5.2",
        "@semantic-release/changelog": "^6.0.3",
        "@semantic-release/exec": "^7.1.0",
        "@semantic-release/git": "^10.0.1",
        "@semantic-release/github": "^12.0.5",
        "@tailwindcss/vite": "^4.0.0",
        "alpinejs": "^3.4.2",
        "autoprefixer": "^10.4.2",
        "axios": "^1.8.2",
        "concurrently": "^9.0.1",
        "conventional-changelog-conventionalcommits": "^9.3.1",
        "laravel-vite-plugin": "^1.2.0",
        "postcss": "^8.4.31",
        "semantic-release": "^25.0.3",
        "tailwindcss": "^3.1.0",
        "vite": "^6.2.4"
    }
}
